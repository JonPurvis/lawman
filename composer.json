{
    "name": "jonpurvis/lawman",
    "description": "A PestPHP Plugin to help with architecture testing SaloonPHP integrations",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "plugin",
        "saloon"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jon Purvis",
            "homepage": "https://jonathanpurvis.co.uk"
        }
    ],
    "require": {
        "php": "^8.3",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "JonPurvis\\Lawman\\": "src/",
            "Tests\\Fixtures\\Arch\\": "tests/Fixtures/Arch"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest-plugin-type-coverage": "^4.0 || ^5.0",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.5",
        "saloonphp/cache-plugin": "^3.1",
        "saloonphp/pagination-plugin": "^2.0",
        "saloonphp/rate-limit-plugin": "^2.5",
        "saloonphp/saloon": "^4.0",
        "symfony/var-dumper": "^7.0 || ^8.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel",
            "rector"
        ],
        "refactor": "rector",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:refactor": "rector --dry-run",
        "test:unit": "pest --parallel --coverage",
        "test:types": "phpstan",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    }
}
